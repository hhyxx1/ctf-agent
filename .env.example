# ============================================================
# CTF Agent 配置文件模板
# 复制为 .env 后填写你的真实值：
#   cp .env.example .env
# 注意：.env 已被 .gitignore 忽略，不会提交到仓库
# ============================================================

# ── 大模型（必填）──
# OpenAI 兼容接口的 API Key（DeepSeek/OpenAI/通义/本地 vLLM 等任意兼容服务）
DEEPSEEK_API_KEY=
# OpenAI 兼容接口地址（默认 OpenAI 官方；DeepSeek 用 https://api.deepseek.com，本地 vLLM 用 http://localhost:8000/v1）
DEEPSEEK_BASE_URL=https://api.openai.com/v1
# 模型名（按你的服务填，如 gpt-4o-mini / deepseek-chat / qwen-plus 等）
DEEPSEEK_MODEL=gpt-4o-mini

# ── 答题 API（可选，跑平台评测时用）──
# TSecBench 等平台下发的任务鉴权 token 与地址
# BENCHMARK_TOKEN=xxxx-xxxx-xxxx
# BENCHMARK_BASE_URL=https://your-benchmark-platform.com
# 兼容别名（二选一即可）
COMPETITION_BASE_URL=
COMPETITION_API_BASE_URL=
COMPETITION_TOKEN=

# ── 反作弊路径配置（可选，按你的环境填）──
# 禁止 Agent 访问的路径（跑分集源码/答案），JSON 列表字符串
# 例如: FORBIDDEN_PATHS=["/data/cybench","/data/xben","metadata/solution"]
FORBIDDEN_PATHS=
# 合法工作目录前缀（runner 复制题目的临时目录），JSON 列表
# 例如: ALLOWED_WORKDIRS=["/tmp/cybench_chal_","/tmp/src_audit_"]
ALLOWED_WORKDIRS=

# ── Agent 行为（可选，有默认值）──
# 单题最大推理轮次
# MAX_ITERATIONS=25
# LLM 请求超时（秒）
# LLM_TIMEOUT=90
# LLM 最大输出 token
# LLM_MAX_TOKENS=4096
# LLM 温度
# LLM_TEMPERATURE=0.2
# 工具执行超时（秒）
# TOOL_TIMEOUT=120

# ── 运行控制（可选，有默认值）──
# 镜像启动后是否立即开始解题（托管模式必须 true）
# AUTO_START=true
# 单题最大重试次数
# MAX_ATTEMPTS=3
# 总时限（秒）
# TOTAL_TIMEOUT_SEC=21000
# 并发容器上限
# MAX_CONCURRENT=3

# ── 网关模式（托管平台专用，本地不要开）──
# GATEWAY_MODE=off   本地模式（直连 api.deepseek.com）
# GATEWAY_MODE=open  托管模式（走 .tsecbench.gw 网关）
